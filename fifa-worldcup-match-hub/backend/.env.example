# TheSportsDB (https://www.thesportsdb.com/) — primary data source: fixtures, timelines,
# basic stats, images. "3" is the public free test key; no signup needed. Free tier caps
# lineups at 5 players/match (a $9/mo Patreon key removes that cap — see README).
SPORTSDB_KEY=3
SPORTSDB_HOST=www.thesportsdb.com
SPORTSDB_LEAGUE_ID=4429

# API-Football (https://www.api-football.com/) is OPTIONAL: an enhancement layer that adds
# richer per-match/per-player stats (passes, tackles, ratings) on top of TheSportsDB data.
# Leave blank to run without it — the app works fully either way.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# Local dev default is SQLite; point this at Supabase/Postgres for deployment
# e.g. postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./worldcup.db

# World Cup league/season — only relevant to the optional API-Football enhancement layer.
WC_LEAGUE_ID=1
WC_SEASON=2026

# Optional: enables pulling comments from each match's highlight video for sentiment scoring.
# Get one free at https://console.cloud.google.com (enable "YouTube Data API v3" -> Create
# Credentials -> API key). Without it, sentiment falls back to Google News RSS only (no key
# needed there) — the feature works either way, just with a thinner signal.
YOUTUBE_API_KEY=

# Comma-separated origins allowed to call this API (the deployed Lovable app URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
