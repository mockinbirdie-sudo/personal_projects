# API-Football (https://www.api-football.com/) — free tier key via RapidAPI or direct
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=v3.football.api-sports.io

# Local dev default is SQLite; point this at Supabase/Postgres for deployment
# e.g. postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./worldcup.db

# World Cup league/season to ingest. Note: API-Football's free plan only allows fetching
# fixtures within ~3 days of today's real date (no historical 2022 data) and restricts the
# `season` filter to 2022-2024 when combined with `league` — see ingestion/api_football_client.py
# for the date-only + client-side-filter workaround. Use the season currently live (2026 WC).
WC_LEAGUE_ID=1
WC_SEASON=2026

# Comma-separated origins allowed to call this API (the deployed Lovable app URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
